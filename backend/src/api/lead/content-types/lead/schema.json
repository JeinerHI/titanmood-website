{
  "kind": "collectionType",
  "collectionName": "leads",
  "info": {
    "singularName": "lead",
    "pluralName": "leads",
    "displayName": "Lead"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "phone": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "calculatorData": {
      "type": "json"
    },
    "state": {
      "type": "enumeration",
      "default": "new",
      "enum": [
        "new",
        "contacted",
        "converted"
      ]
    }
  }
}
