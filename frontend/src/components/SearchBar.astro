---
const { placeholder = "Buscar..." } = Astro.props;
---

<div class="search-container mb-8">
  <div class="relative">
    <input
      type="text"
      id="searchInput"
      placeholder={placeholder}
      class="w-full px-6 py-4 pl-14 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors text-lg"
    />
    <i class="bi bi-search absolute left-5 top-1/2 -translate-y-1/2 text-2xl text-text-secondary"></i>
  </div>
</div>

<style>
  #searchInput::placeholder {
    color: #9ca3af;
  }
</style>
